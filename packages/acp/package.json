{
	"name": "@mariozechner/pi-acp",
	"version": "0.48.0",
	"description": "ACP server and CLI for the pi coding agent",
	"type": "module",
	"bin": {
		"pi-acp": "dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "rm -rf dist",
		"build": "tsgo -p tsconfig.build.json && chmod +x dist/cli.js",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "^0.13.0",
		"@mariozechner/pi-coding-agent": "^0.48.0",
		"chalk": "^5.5.0"
	},
	"devDependencies": {
		"@types/node": "^24.3.0",
		"typescript": "^5.7.3",
		"vitest": "^3.2.4"
	},
	"keywords": [
		"acp",
		"agent-client-protocol",
		"pi",
		"coding-agent",
		"cli"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/badlogic/pi-mono.git",
		"directory": "packages/acp"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
